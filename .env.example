# Copy to .env.local (ignored by Git); use chmod 600 .env.local.
# Long-running development service exposed through Merlin; requires tmux and Node.js 24.
OPENFOLIO_SERVICE_PORT=10680
OPENFOLIO_SERVICE_HOST=::
OPENFOLIO_SERVICE_SESSION=openfolio-preview
# Empty uses ~/.local/share/open-folio; routine updates preserve this directory.
OPENFOLIO_DATA_DIR=

# Agent chooses verification steps for each task; no fixed smoke-test script.
# Set the reachable OpenFolio URL and your real workspace Token only in .env.local.
OPENFOLIO_VERIFY_BASE_URL=http://127.0.0.1:10680
OPENFOLIO_VERIFY_TOKEN=

# Optional deployment settings; empty uses private files in OPENFOLIO_DATA_DIR.
OPENFOLIO_CONFIG=
OPENFOLIO_ADMIN_PASSWORD=
OPENFOLIO_CREDENTIAL_KEY_FILE=
# Optional Chromium executable for prototype screenshots.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
