# 复制为 .env（已被 Git 忽略），并执行 chmod 600 .env。
# Merlin 长期暴露的开发服务，需要 tmux 和 Node.js 24。
OPENFOLIO_SERVICE_PORT=10680
OPENFOLIO_SERVICE_HOST=::
OPENFOLIO_SERVICE_SESSION=openfolio-preview
# 留空时使用 ~/.local/share/open-folio，常规更新保留此目录。
OPENFOLIO_DATA_DIR=

# Agent 自主选择验证步骤，真实登录使用 scripts/smoke-session.ts 自动退出并校验。
# 在忽略的本地 .env 中填写验证地址、专用账号密码和 Git Token。
OPENFOLIO_VERIFY_BASE_URL=http://127.0.0.1:10680
# 专用验证账号：先通过注册接口创建，不使用真实用户会话。
OPENFOLIO_VERIFY_USERNAME=
OPENFOLIO_VERIFY_PASSWORD=
# Git 访问令牌：登录后绑定，用于验证仓库读取。
OPENFOLIO_VERIFY_TOKEN=

# 可选配置文件路径；留空时使用 OPENFOLIO_DATA_DIR 内的 config.json。
OPENFOLIO_CONFIG=
# 部署管理密码：仅用于修改服务资源限制、获取原型上传地址及撤回公开版本。
# 与个人账号独立，不授予工作台登录或仓库读取权限。
# 留空时读取 OPENFOLIO_DATA_DIR 内的 admin-password；文件缺失时自动生成并私有保存。
OPENFOLIO_ADMIN_PASSWORD=
# 留空时使用 OPENFOLIO_DATA_DIR/personal/credential-key，须与工作台数据配套。
OPENFOLIO_CREDENTIAL_KEY_FILE=
# 可选的 Chromium 可执行文件路径，用于原型截图。
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# 原型发布至 Cloudflare R2；发布脚本自动加载根目录环境文件。
# 进程环境变量优先，其次 .env.local，最后 .env。
R2_ACCOUNT_ID=
R2_BUCKET=open-folio-prototypes
# 桶的公开 HTTPS 地址（r2.dev 或绑定域名），不是 S3 API 地址。
R2_PUBLIC_BASE_URL=
# 仅授权目标桶 Object Read & Write 的 S3 API 凭据。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
