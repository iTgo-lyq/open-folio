{
  "name": "open-folio",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 10681",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 10681",
    "service:start": "node scripts/service.mjs start",
    "service:stop": "node scripts/service.mjs stop",
    "service:status": "node scripts/service.mjs status",
    "service:update": "node scripts/service.mjs update",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @open-folio/ui",
    "test": "node --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "node --conditions=react-server node_modules/@playwright/test/cli.js test",
    "format:check": "prettier --check src tests *.ts *.json README.md packages/ui",
    "format": "prettier --write src tests *.ts *.json README.md packages/ui",
    "ui:dev": "npm run dev --workspace @open-folio/ui",
    "ui:build": "npm run build --workspace @open-folio/ui",
    "ui:preview": "npm run preview --workspace @open-folio/ui",
    "ui:test": "node tests/ui-preview.mjs"
  },
  "dependencies": {
    "@next/env": "16.3.7",
    "lucide-react": "0.577.0",
    "next": "16.3.7",
    "playwright": "1.63.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "unified": "11.0.5",
    "zod": "3.25.76",
    "@open-folio/ui": "*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/prototype",
    "packages/ui"
  ]
}
