    "zod": "3.25.76",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@playwright/test": "1.63.0",
    "tailwindcss": "4.3.3",
